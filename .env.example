# QueryNova reads the WordPress environment via wp_get_environment_type().
# Valid values: local, development, staging, production.
# Set this in wp-config.php:
#
# define( 'WP_ENVIRONMENT_TYPE', 'local' );
#
# Do not put API keys, tokens, or customer data in this file.
# Provider credentials are saved server-side from the QueryNova admin.
WP_ENVIRONMENT_TYPE=local
